generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mscliente {
  codcliente    Int        @id @default(autoincrement())
  nome          String     @db.VarChar(200)
  cpf_cnpj      String?    @db.VarChar(20)
  telefone      String?    @db.VarChar(20)
  email         String?    @db.VarChar(200)
  endereco      String?    @db.VarChar(200)
  numero        String?    @db.VarChar(20)
  bairro        String?    @db.VarChar(100)
  cidade        String?    @db.VarChar(100)
  estado        String?    @db.VarChar(2)
  cep           String?    @db.VarChar(10)
  data_cadastro DateTime?  @default(now()) @db.DateTime(0)
  ativo         String?    @default("S") @db.Char(1)
  mspedido      mspedido[]
}

model msforma_pagamento {
  codforma   Int     @id @default(autoincrement())
  descricao  String  @db.VarChar(100)
  prazo_dias Int?    @default(0)
  ativo      String? @default("S") @db.Char(1)
}

model msproduto {
  codproduto     Int             @id @default(autoincrement())
  descricao      String          @db.VarChar(200)
  marca          String?         @db.VarChar(100)
  codcategoria   Int?
  codigo_barras  Decimal?        @db.Decimal(20, 0)
  volume_ml      Int?
  preco_normal   Decimal         @db.Decimal(12, 2)
  preco_promocao Decimal?        @db.Decimal(12, 2)
  ativo          String?         @default("S") @db.Char(1)
  data_cadastro  DateTime?       @default(now()) @db.DateTime(0)
  resumo         String?         @db.VarChar(255)
  mspedido_item  mspedido_item[]
}

model msstatus_pedido {
  codstatus Int    @id @default(autoincrement())
  descricao String @db.VarChar(50)
}

model msusuario {
  codusur                                       Int        @id @default(autoincrement())
  nome                                          String     @db.VarChar(200)
  cpf                                           String?    @unique(map: "cpf") @db.VarChar(11)
  data_nascimento                               DateTime?  @db.Date
  email                                         String?    @db.VarChar(200)
  telefone                                      String?    @db.VarChar(20)
  login                                         String     @unique(map: "login") @db.VarChar(100)
  senha_hash                                    String     @db.VarChar(255)
  tipo_usuario                                  String?    @db.VarChar(20)
  codfilial                                     Int?
  codrca                                        Int?
  ativo                                         String?    @default("S") @db.Char(1)
  data_criacao                                  DateTime?  @default(now()) @db.DateTime(0)
  ultimo_login                                  DateTime?  @db.DateTime(0)
  mspedido_mspedido_codusur_criouTomsusuario    mspedido[] @relation("mspedido_codusur_criouTomsusuario")
  mspedido_mspedido_codusur_vendedorTomsusuario mspedido[] @relation("mspedido_codusur_vendedorTomsusuario")
}

model msentrada_estoque {
  id                  Int       @id @default(autoincrement())
  codproduto          Int
  codfilial           Int
  quantidade          Int
  quantidade_restante Int
  custo_unitario      Decimal   @db.Decimal(12, 2)
  data_entrada        DateTime? @default(now()) @db.DateTime(0)

  @@index([codfilial], map: "idx_filial")
  @@index([codproduto], map: "idx_produto")
}

model msestoque {
  codproduto    Int
  codfilial     Int
  quantidade    Int      @default(0)
  atualizado_em DateTime @default(now()) @db.Timestamp(0)

  @@id([codproduto, codfilial])
}

model msmov_estoque {
  id         Int       @id @default(autoincrement())
  codproduto Int
  codfilial  Int
  tipo       String?   @db.VarChar(20)
  origem     String?   @db.VarChar(50)
  quantidade Int
  data_mov   DateTime? @default(now()) @db.DateTime(0)
  origem_id  Int?
}

model mscategoria {
  codcategoria Int     @id @default(autoincrement())
  categoria    String? @db.VarChar(50)
}

model msfilial {
  codfilial Int     @id @default(autoincrement())
  filial    String? @db.VarChar(100)
}

model msmarca {
  codmarca Int     @id @default(autoincrement())
  marca    String? @db.VarChar(60)
}

model mspedido {
  numpedido                                      Int             @id @default(autoincrement())
  codcliente                                     Int
  codusur_criou                                  Int?
  codusur_vendedor                               Int?
  data_pedido                                    DateTime?       @default(now()) @db.DateTime(0)
  valor_total                                    Decimal?        @db.Decimal(12, 2)
  status                                         String?         @db.VarChar(20)
  codfilial                                      Int?
  mscliente                                      mscliente       @relation(fields: [codcliente], references: [codcliente], onDelete: NoAction, onUpdate: NoAction, map: "mspedido_ibfk_1")
  msusuario_mspedido_codusur_criouTomsusuario    msusuario?      @relation("mspedido_codusur_criouTomsusuario", fields: [codusur_criou], references: [codusur], onDelete: NoAction, onUpdate: NoAction, map: "mspedido_ibfk_2")
  msusuario_mspedido_codusur_vendedorTomsusuario msusuario?      @relation("mspedido_codusur_vendedorTomsusuario", fields: [codusur_vendedor], references: [codusur], onDelete: NoAction, onUpdate: NoAction, map: "mspedido_ibfk_3")
  mspedido_item                                  mspedido_item[]

  @@index([codcliente], map: "codcliente")
  @@index([codusur_criou], map: "codusur_criou")
  @@index([codusur_vendedor], map: "codusur_vendedor")
}

model mspedido_item {
  coditem        Int        @id @default(autoincrement())
  numpedido      Int?
  codproduto     Int?
  quantidade     Int?
  preco_unitario Decimal?   @db.Decimal(12, 2)
  valor_total    Decimal?   @db.Decimal(12, 2)
  mspedido       mspedido?  @relation(fields: [numpedido], references: [numpedido], onDelete: NoAction, onUpdate: NoAction, map: "mspedido_item_ibfk_1")
  msproduto      msproduto? @relation(fields: [codproduto], references: [codproduto], onDelete: NoAction, onUpdate: NoAction, map: "mspedido_item_ibfk_2")

  @@index([codproduto], map: "codproduto")
  @@index([numpedido], map: "numpedido")
}

model msvendedor {
  codvendedor  Int       @id @default(autoincrement())
  nome         String?   @db.VarChar(200)
  ativo        String?   @db.Char(1)
  cpf          String?   @db.VarChar(11)
  data_criacao DateTime? @db.Date
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model BancoMSTECH {
  INSERT_INTO_mstech_mscategoria__categoria__VALUES String? @map("INSERT INTO mstech.mscategoria (categoria) VALUES") @db.VarChar(50)

  @@ignore
}
